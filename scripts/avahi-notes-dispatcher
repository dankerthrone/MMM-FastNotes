#!/bin/bash
#
# NetworkManager dispatcher script for MMM-FastNotes.
#
# Keeps the mDNS alias "notes.local" pointing at the current IP address of
# this machine by rewriting /etc/avahi/hosts and restarting avahi-daemon
# (SIGHUP is NOT enough, avahi only reloads service definitions then).
#
# Installed by scripts/setup.sh to:
#   /etc/NetworkManager/dispatcher.d/50-avahi-notes
#
# Called by NetworkManager as:  50-avahi-notes <interface> <action>
# Can be run manually as root:  50-avahi-notes wlan0 up
#
INTERFACE="$1"
ACTION="$2"

HOSTNAME_ALIAS="notes.local"
HOSTS_FILE="/etc/avahi/hosts"

case "$ACTION" in
  up|dhcp4-change|connectivity-change|reapply|renew|register)
    ;;
  *)
    exit 0
    ;;
esac

# Current address of the default route (fall back to first global address),
# so the alias follows DHCP changes automatically.
IP=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]\{1,\}\).*/\1/p' | head -n 1)
if [ -z "$IP" ]; then
  IP=$(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}')
fi

# Nothing to publish yet - keep whatever we had before.
if [ -z "$IP" ]; then
  exit 0
fi

NEW_LINE="$IP $HOSTNAME_ALIAS"
TMP=$(mktemp) || exit 0
trap 'rm -f "$TMP"' EXIT

if [ -f "$HOSTS_FILE" ] && grep -q "^[[:space:]]*[^#].*$HOSTNAME_ALIAS" "$HOSTS_FILE" 2>/dev/null; then
  sed "s|^[[:space:]]*[^#]*$HOSTNAME_ALIAS.*|$NEW_LINE|" "$HOSTS_FILE" > "$TMP"
else
  if [ -f "$HOSTS_FILE" ]; then
    cat "$HOSTS_FILE" > "$TMP"
  else
    printf '%s\n' \
      "# Static mDNS host names for avahi." \
      "# Managed by MMM-FastNotes (dispatcher.d/50-avahi-notes)." > "$TMP"
  fi
  printf '%s\n' "$NEW_LINE" >> "$TMP"
fi

cp "$TMP" "$HOSTS_FILE" 2>/dev/null || cat "$TMP" > "$HOSTS_FILE"

# Restart so avahi picks up the new alias (it only reloads services on SIGHUP).
if command -v systemctl >/dev/null 2>&1; then
  systemctl try-restart avahi-daemon.service >/dev/null 2>&1 || true
elif command -v avahi-daemon >/dev/null 2>&1; then
  avahi-daemon -r >/dev/null 2>&1 || true
fi

exit 0
